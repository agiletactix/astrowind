---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AgileTactix — Transform from Theory-Chaser to AI-Powered Partner',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Get Free Blueprint Course',
        href: '/blueprint',
        icon: 'tabler:arrow-right',
      },
      { text: 'See How It Works', href: '#story' },
    ]}
  >
    <Fragment slot="title">
      <span class="block text-sm font-semibold uppercase tracking-wide text-blue-600 dark:text-blue-400 mb-4">
        From Manual to Automated
      </span>
      <span class="text-gray-500 dark:text-gray-400">From Theory-Chaser</span> →<br />
      <span class="text-accent dark:text-white highlight"> AI-Powered Partner</span>
    </Fragment>

    <Fragment slot="subtitle">
      Stop chasing certifications. Start mastering automation. Learn how agile professionals are using AI to 10x their impact (and income).
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Students Trained', amount: '13,000+' },
      { title: 'Agile Experience', amount: '15+ Years' },
      { title: 'Current Consulting', amount: 'Fortune 500' },
    ]}
    classes={{ container: '-mt-8 md:-mt-12 pt-0 md:pt-0 pb-8 md:pb-12' }}
  />

  <!-- Story Section ***************** -->

  <Content
    id="story"
    tagline="The Wake-Up Call"
    title="Laid off from banking in 2023. Landed a Fortune 500 pharma contract 6 weeks later. The difference? Automation skills."
  >
    <Fragment slot="content">
      <p class="text-lg text-muted mb-6">
        After 15 years as an agile professional, I thought I was safe. Scrum Master, Product Owner, Release Train Engineer – I had the certifications and experience. But when the layoffs came, my resume looked like everyone else's.
      </p>
      <p class="text-lg text-muted mb-6">
        What saved me wasn't another certificate. It was showing hiring managers how I'd automated Jira workflows, built custom dashboards, and used AI to handle repetitive coordination work. While other candidates talked about "servant leadership," I showed working automation that saved 20 hours per sprint.
      </p>
      <p class="text-lg text-muted font-semibold">
        That's what Agile Tactix teaches you. Not theory. Tactical automation that makes you irreplaceable.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- What You'll Master Features *** -->

  <Features
    id="features"
    tagline="What You'll Master"
    title="Real automation patterns used in enterprise agile teams"
    subtitle="No fluff, no theory. Just working solutions you can implement Monday morning."
    items={[
      {
        title: 'Atlassian Automation',
        description:
          'Master Jira automation rules, Confluence macros, and Atlassian Rovo for AI-powered team coordination. Enterprise-proven patterns from Fortune 500 implementations.',
        icon: 'tabler:bolt',
      },
      {
        title: 'AI-Powered Workflows',
        description:
          'Build custom AI assistants using Claude API, automate standup reports, sprint planning prep, and stakeholder communications. Work smarter, not harder.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Real-World Patterns',
        description:
          'Copy-paste automation patterns tested in production. Not hypothetical examples – actual workflows running in enterprise environments right now.',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get Your Free Blueprint Now',
        href: '/blueprint',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Become Irreplaceable?
    </Fragment>

    <Fragment slot="subtitle">
      Start with the free AI-Powered Agile Blueprint. 3 lessons that show you exactly how to automate your first workflow.<br class="hidden md:inline" />
      <span class="text-sm text-muted mt-2 block">No credit card required. Join the community in 60 seconds.</span>
    </Fragment>
  </CallToAction>
</Layout>
