---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(41 75 243);
    --aw-color-secondary: rgb(0 168 204);
    --aw-color-accent: rgb(41 75 243);

    --aw-color-text-heading: rgb(26 26 26);
    --aw-color-text-default: rgb(26 26 26);
    --aw-color-text-muted: rgb(26 26 26 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(26 26 26);

    ::selection {
      background-color: rgb(240 247 255);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(41 75 243);
    --aw-color-secondary: rgb(0 168 204);
    --aw-color-accent: rgb(41 75 243);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(26 26 26);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
