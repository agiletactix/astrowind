---
import type { ItemGrid as Props } from '~/types';
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import Button from './Button.astro';

const { items = [], columns, defaultIcon = '', classes = {} } = Astro.props;

const {
  container: containerClass = '',
  // container: containerClass = "sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'text-primary',
} = classes;

// Icon background colors for each card
const iconBackgrounds = ['bg-blue-100', 'bg-purple-100', 'bg-yellow-100'];
const checkmarkColors = ['text-blue-600', 'text-purple-600', 'text-orange-600'];
---

{
  items && items.length > 0 && (
    <div
      class={twMerge(
        `grid gap-8 gap-x-12 sm:gap-y-8 ${
          columns === 4
            ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
            : columns === 3
              ? 'lg:grid-cols-3 sm:grid-cols-2'
              : columns === 2
                ? 'sm:grid-cols-2 '
                : ''
        }`,
        containerClass
      )}
    >
      {items.map(({ title, description, icon, callToAction, items: nestedItems, classes: itemClasses = {} }, index) => (
        <div
          class={twMerge(
            'relative flex flex-col intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
            panelClass,
            itemClasses?.panel
          )}
        >
          {(icon || defaultIcon) && (
            <div class={twMerge('w-12 h-12 rounded-lg flex items-center justify-center mb-6', iconBackgrounds[index % iconBackgrounds.length])}>
              <Icon name={icon || defaultIcon} class={twMerge('w-6 h-6', defaultIconClass, itemClasses?.icon)} />
            </div>
          )}
          <div class={twMerge('text-2xl font-bold mb-6', titleClass, itemClasses?.title)}>{title}</div>
          {description && (
            <p class={twMerge('text-muted mt-2', descriptionClass, itemClasses?.description)} set:html={description} />
          )}
          {nestedItems && nestedItems.length > 0 && (
            <ul class="space-y-3">
              {nestedItems.map((item) => (
                <li class="flex items-start gap-3">
                  <svg
                    class={twMerge('w-6 h-6 rounded-full flex-shrink-0 mt-0.5', checkmarkColors[index % checkmarkColors.length])}
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-base text-gray-700 dark:text-gray-300 leading-relaxed">{item.title}</span>
                </li>
              ))}
            </ul>
          )}
          {callToAction && callToAction.text && callToAction.text.trim() !== '' && (
            <div class="mt-2">
              <Button {...callToAction} />
            </div>
          )}
        </div>
      ))}
    </div>
  )
}
