---
import { Image } from 'astro:assets';
// @ts-ignore
import logoLight from '~/assets/images/agiletactix-logo-light.png';
// @ts-ignore
import logoDark from '~/assets/images/agiletactix-logo-dark.png';
---

<!-- Light mode logo (dark text) -->
<Image
  src={logoLight}
  alt="AgileTactix"
  width={200}
  height={50}
  class="h-10 w-auto dark:hidden"
  loading="eager"
/>

<!-- Dark mode logo (light text) -->
<Image
  src={logoDark}
  alt="AgileTactix"
  width={200}
  height={50}
  class="h-10 w-auto hidden dark:block"
  loading="eager"
/>
