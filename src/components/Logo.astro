---
import { Image } from 'astro:assets';
import logoLight from '~/assets/images/Agiletactix-logo.png';
import logoDark from '~/assets/images/Agiletactix-logo-dark-mode.png';
---

<!-- Light mode logo (dark text) -->
<Image
  src={logoLight}
  alt="AgileTactix"
  width={1000}
  height={250}
  class="h-10 w-auto dark:hidden"
  loading="eager"
  quality="max"
/>

<!-- Dark mode logo (light text) -->
<Image
  src={logoDark}
  alt="AgileTactix"
  width={1000}
  height={250}
  class="h-10 w-auto hidden dark:block"
  loading="eager"
  quality="max"
/>
